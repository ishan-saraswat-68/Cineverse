# ==========================================
# CINEVERSE CLIENT ENVIRONMENT VARIABLES
# ==========================================

# Backend API & WebSocket Server URL
VITE_BASE_URL=http://localhost:3000

# Clerk Authentication (Get Publishable Key from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Display Currency Symbol or Code (e.g. ₹, $, €, USD)
VITE_CURRENCY='₹'

# TMDB Image Base URL (Default: https://image.tmdb.org/t/p/original or https://image.tmdb.org/t/p/w500)
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original

# Seat Lock TTL in Seconds (Optional, default matches backend 300 seconds)
VITE_SEAT_LOCK_TTL_SECONDS=300
