# ==========================================
# CINEVERSE BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/cineverse

# Clerk Authentication (Get from https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Inngest Background Jobs & Workflows (Get from https://app.inngest.com or run local Inngest Dev Server)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key

# TMDB API (The Movie Database - API v3 Auth Key or v4 Read Access Token from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_read_access_token_or_key

# Stripe Payment Gateway (Get from https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret (Obtained via `stripe listen --forward-to localhost:3000/api/stripe` or Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Upstash Redis / Redis URL for Real-Time Distributed Seat Locking (Get from https://console.upstash.com)
# Format: rediss://default:<password>@<host>:<port> or redis://127.0.0.1:6379
REDIS_URL=rediss://default:your_upstash_redis_password@your-redis-host.upstash.io:6379

# Seat Lock Time-To-Live in Seconds (Default: 300 = 5 minutes)
SEAT_LOCK_TTL_SECONDS=300

# Nodemailer / SMTP Email Service (e.g., Brevo / Sendinblue, Gmail, or SendGrid)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_username
SMTP_PASS=your_smtp_password_or_api_key
SENDER_EMAIL=noreply@yourdomain.com
