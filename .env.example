# ==============================================================================
# CINEVERSE - ENVIRONMENT VARIABLES OVERVIEW
# ==============================================================================
# Cineverse is a full-stack movie ticket booking platform with a React (Vite)
# frontend and an Express + Socket.IO backend.
#
# Please configure the respective environment files:
# 1. Server Configuration: Copy `server/.env.example` -> `server/.env`
# 2. Client Configuration: Copy `client/.env.example` -> `client/.env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER (.env in ./server)
# ------------------------------------------------------------------------------
PORT=3000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cineverse
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...
TMDB_API_KEY=...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
REDIS_URL=rediss://default:<password>@<host>:<port>
SEAT_LOCK_TTL_SECONDS=300
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SENDER_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 2. CLIENT (.env in ./client)
# ------------------------------------------------------------------------------
VITE_BASE_URL=http://localhost:3000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CURRENCY='₹'
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original
VITE_SEAT_LOCK_TTL_SECONDS=300
